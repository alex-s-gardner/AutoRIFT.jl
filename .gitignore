.DS_Store
.vscode/
*.jl.cov
*.jl.*.cov
*.jl.mem
/docs/build/
/docs/node_modules/
/docs/src/.vitepress/cache/
/docs/package-lock.json

# A library does not commit its Manifest: it pins exact versions resolved by one
# Julia version, and CI tests against several. The root one *was* committed, which
# broke every `lts` (1.10) job — the manifest had been resolved on 1.12, so Pkg
# could not locate the stdlib sources it named. Applications pin; libraries resolve.
/Manifest.toml

# Benchmark runs are per-machine; only baseline.json and python.json are
# committed, since those are the references everything else is compared against.
/benchmark/results/history/
/benchmark/Manifest.toml

# Large end-to-end fixtures are fetched on demand rather than committed; the
# small primitive fixtures under test/fixtures/ ARE committed so the suite runs
# on a bare clone.
/test/fixtures/scenes/
/test/Manifest.toml

# The trimmed binary and its bundled runtime libraries: build products, and the
# bundle is ~71 MiB. Built on demand; see app/README.md.
/app/build/
/app/Manifest.toml

# A/B run artifacts: the shared input arrays and each side's output, ~95 MiB per run, regenerated
# from the real-data cache by the stage scripts. The scripts that produce them are kept.
/tools/ab/stage1/
/tools/ab/stage2/
/tools/ab/Manifest.toml
__pycache__/

# Synthetic benchmark artifacts: the generated scenes (~200 MiB, rebuilt by scenes.jl in about eleven
# seconds) and each arm's output beside them. `results.json` and the README are the committed record.
/tools/synth/scenes/
/tools/synth/plots/
/tools/synth/Manifest.toml

# Rendered figures and reports. Each is a few MiB of binary, regenerated by the scripts beside them
# from bench_table.json plus the stage bundles, and a fresh render on every run would add a new blob
# rather than a diff. The numbers they show are recorded in tools/ab/README.md and bench_table.json,
# which are text.
/tools/ab/plots/

# Benchmark timings from tools/ab: absolute wall-clock is machine-specific, and the measured
# ratios are recorded in tools/ab/README.md.
/tools/ab/bench_julia.txt
/tools/ab/bench_python.txt
/tools/ab/bench_pair_*.bin
/tools/ab/bench_scene.bin
