+# Grid points beyond a block's own range that the *coarse* pass may search.
+#
+# `issearchable` answers on a point's own radius, and two things replace that radius with a maximum over a
+# neighbourhood: `_cell_max_radius!` gives a coarse point the widest radius within
+# `_sparse_filter_width(_sparse_stride(p))` points of it, and `_decimate_level` makes a decimated point
+# stand for its whole `stride`-by-`stride` cell. So a point whose own radius is zero becomes searchable
+# once either applies, and this is how far that reaches in points of the grid the layout was built from.
+#
+# The two compose — a decimated level's coarse pass widens over `_sparse_filter_width` points of the
+# *decimated* grid — so the cell term multiplies rather than adds.
+function _coarse_grid_reach(p::Params)
+    half = _sparse_filter_width(_sparse_stride(p)) ÷ 2
+    decim = maximum(cs -> _level_decimation(p, cs), chip_sizes(p))
+    return decim * (half + 1)
+end
+
+# The pixel window a block must read, covering what the *coarse* pass may search as well as what the fine
+# pass will.
+#
+# [`AutoRIFT._searchable_span`](@ref) reduces over points searchable on their own radius, which is the set
+# the fine pass correlates and not the set the coarse pass does — see `AutoRIFT._coarse_grid_reach`.
+# Reducing without the inherited points gave a window their search reached past, and `track!` zero-padded
+# the shortfall, so the coarse pass searched padding where a whole-scene run searched imagery. Its evidence
+# then differed, and the mask it dilates from that evidence gates the fine pass over whole regions.
+# Measured on a Sentinel-1 geogrid at a 2048-pixel block: 303-668 coarse points per level with their search
+# window outside the block's, one block per level whose window was empty with 3,503 grid points in it, and
+# 5.3% of the run's points lost once the chip-size cascade amplified the difference.
+#
+# Two corrections, both needed:
+#
+#   * **Reduce over a range grown by `reach`**, so a block holding only inherited coarse points still finds
+#     real coordinates to bound them by. A block with no searchable point of its own otherwise gets an
+#     empty window while its coarse points are searchable.
+#   * **Pad the span by `reach` in pixels**, since an inherited point's own position can lie outside the
+#     bounding box of the points it inherited from. Both index directions charge both axes on a rotated
+#     grid, so each pad sums two rates — the coupling `AutoRIFT._block_shape` handles for the same reason.
+#
+# The pad applies **only where the grown range mixes searchable and unsearchable points**, which is what
+# keeps it free on a grid [`AutoRIFT.gridpoints`](@ref) built: there every point is searchable, no point can
+# inherit a radius it did not have, and the window is unchanged. A range with no searchable point at all
+# stays empty, which is correct — nothing within `reach` of it can be searchable either.
+function _coarse_read_span(grid::PointSet{2}, rates, reach::Int, grows, gcols,
+                           gridsize::Tuple{Int,Int})
+    nr, nc = gridsize
+    srows = max(first(grows) - reach, 1):min(last(grows) + reach, nr)
+    scols = max(first(gcols) - reach, 1):min(last(gcols) + reach, nc)
+    rlo = clo = Inf
+    rhi = chi = -Inf
+    mixed = false
+    # One traversal for both: the span over searchable points, and whether any point here is not one.
+    @inbounds for j in scols, i in srows
+        if !issearchable(grid, CartesianIndex(i, j))
+            mixed = true
+            continue
+        end
+        y, x = grid.y[i, j], grid.x[i, j]
+        (isfinite(y) && isfinite(x)) || continue
+        rlo = min(rlo, y); rhi = max(rhi, y)
+        clo = min(clo, x); chi = max(chi, x)
+    end
+    isfinite(rlo) || return (nothing, nothing, nothing, nothing)
+    lo_r, hi_r = floor(Int, rlo), ceil(Int, rhi)
+    lo_c, hi_c = floor(Int, clo), ceil(Int, chi)
+    mixed || return (lo_r, hi_r, lo_c, hi_c)
+    ex = ceil(Int, reach * (rates.rxi + rates.rxj))
+    ey = ceil(Int, reach * (rates.ryi + rates.ryj))
+    return (lo_r - ey, hi_r + ey, lo_c - ex, hi_c + ex)
+end
